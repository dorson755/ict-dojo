{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendWeeklyReportFromOneAddress",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:us-east-2:507519853329:identity/aldion.life",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "reports@aldion.life"
        }
      }
    }
  ]
}
